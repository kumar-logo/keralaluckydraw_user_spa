# ─── Kerala Lottery SPA Environment Configuration ───
#
# Copy this file to `.env.local` and adjust values for your environment.
# Vite only exposes variables prefixed with VITE_ to the client bundle.
#
# All variables are OPTIONAL — the app falls back to dynamic host-based
# detection in production (deriving api.{domain}.{tld} from window.location).

# API base URL — overrides the dynamic host-based URL when set.
# In development, Vite proxy handles routing; leave empty or set to '/'.
VITE_API_BASE_URL=

# WebSocket host — overrides the dynamic WS host when set.
# In development, Vite proxy handles /user/service; leave empty.
VITE_WS_HOST=

# Dev proxy target — used by vite.config.ts dev server proxy.
# Only affects `npm run dev`; ignored in production builds.
VITE_DEV_PROXY_TARGET=http://localhost:3000
