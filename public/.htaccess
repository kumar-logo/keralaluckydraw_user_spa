RewriteEngine On
RewriteBase /

# Proxy /uploads/ to the backend API subdomain (images served by Node.js).
# Requires mod_proxy + mod_proxy_http; if unavailable on the host, serve images
# via absolute https://api.keralaluckydraw.com/uploads/... URLs from the API instead.
RewriteCond %{REQUEST_URI} ^/uploads/ [NC]
RewriteRule ^/?uploads/(.*)$ https://api.keralaluckydraw.com/uploads/$1 [P,L]

# Don't rewrite actual files and directories
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything to index.html for SPA
RewriteRule . /index.html [L]

# Cache static assets (JS, CSS, images)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Cache-Control: the SPA shell must NEVER be cached, or a new deploy keeps
# serving a stale index.html that points at deleted (hashed) JS/CSS bundles —
# the browser then 404s those files and the app fails to load. Only the
# content-addressed /assets/ bundles are frozen (immutable); fixed-path
# resources like /locales/*.json keep normal revalidation so content updates
# (e.g. translations) still take effect.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|service-worker\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  SetEnvIf Request_URI "^/assets/" IS_HASHED_ASSET
  Header set Cache-Control "public, max-age=31536000, immutable" env=IS_HASHED_ASSET
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
